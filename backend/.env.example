# EduNova backend configuration
DATABASE_URL=postgresql+asyncpg://edunova_user:edunova_pass@localhost:5433/edunova_db
JWT_SECRET=edunova-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Embedding provider: "local" (offline, deterministic) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Match engine weights
SEMANTIC_WEIGHT=0.6
PREFERENCE_WEIGHT=0.4

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]